{
  "name": "vetmanagerpro",
  "version": "1.0.0",
  "description": "Proyecto: VetManagerPro",
  "main": "electron.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "electron": "electron .",
    "build-exe": "electron-builder"
  },
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.5.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.vetmanager.pro",
    "productName": "VetManager Pro",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      ".env",
      "index.js",
      "src/**/*"
    ]
  }
}
